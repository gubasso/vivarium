# shellcheck shell=bash
use flake

# Per-machine answers that are nobody else's: the drive a disk-heavy run should
# absorb, and the lane knobs documented in docs/reference/microvm-verification-harness.md.
# Untracked, and plain `export` lines only — `tests/host/disk-preflight` sources
# this file directly so a lane invoked outside a direnv shell still finds the
# drive, and it has no direnv stdlib to offer.
source_env_if_exists .envrc.local

# Report, at most once a day, when a newer release-kit exists than the one
# flake.nix pins. The check moves nothing. The operator moves the pin and the
# lock together from a shell, and commits the two-file diff.
rk self-depend check || true

# The warnings of the host exobrain CLI. Each one exits 0 and moves nothing:
# the first reports a newer CLI or newer hook revisions than
# .pre-commit-config.yaml pins, and the second warns once a day about
# working-tree copies in the Nix store.
if command -v exobrain >/dev/null 2>&1; then
  exobrain hooks status || true
  exobrain store-guard --daily || true
fi
