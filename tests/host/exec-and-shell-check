#!/usr/bin/env bash

# Reach into a running guest and check that `viv exec` and `viv shell` behave.
#
# Two tiers, and the split is the *gate*, not the topic:
#
#   Evaluation tier — runs anywhere Nix is present. Builds the launch contract and
#   reads the three facts a session gets from the launch specification rather than
#   from a host constant: where the workspace is mounted in the guest, where the
#   per-target startup lock lives, and what environment the guest itself supplies.
#   Says nothing about target-host behaviour.
#
#   Host tier — gated on /dev/kvm, a systemd user manager and $XDG_RUNTIME_DIR.
#   Runs the acceptance trials that boot a guest and drive real sessions through
#   it: exit-status propagation, the argument boundary, and an interactive shell
#   under a real pty.
#
# Output is one `[PASS]`/`[FAIL]`/`[SKIP]`/`[RECORD]` line per check plus a
# verdict, so the whole run pastes back into a review. A `[SKIP]` means
# *unproven*, never *absent*. A `[RECORD]` is a measurement, not a judgement.
#
# The lane runs TWICE. One clean run is evidence of possibility, not reliability,
# and the assertions this lane cares most about are session-lifetime ones — a
# terminal restored, a reused VM, a process that actually exits — which are
# exactly the kind that pass once and fail on a Tuesday. The first version of the
# interactive trial found a session that completed all its work and never exited,
# because a parked read on a terminal that never reaches end-of-file held the
# async runtime open; that is the class of defect a second run guards.
#
# Unlike the guest-agent lane, this one does not pin the generated flake's
# baseline inputs itself. The acceptance harness pins both from this
# repository's own lock before it runs anything (`baseline_inputs` in
# tests/support/mod.rs), which is the same convention reached from the other
# side. The runtime directory and its sockets are the harness's too: it places
# them under $XDG_RUNTIME_DIR rather than under the scratch root below, because a
# drive-backed control socket path overruns the 108-byte limit and fails as an
# unexplained child exit.
#
# VIVARIUM_TEST_REQUIRE=1 is deliberately NOT set here: this script has already
# proved the gate before it runs the trials, so setting it could only convert a
# genuine environment change into a confusing failure. It is the knob for CI,
# where the gate must not be allowed to silently disable the lane.
#
# See docs/reference/microvm-verification-harness.md for what each check proves
# and for the findings register, and docs/reference/testing-lanes.md for the
# lanes.

SCRIPT_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)
REPO_ROOT=$(CDPATH='' cd -- "$SCRIPT_DIR/../.." && pwd -P)
# `?dir=nix` rather than `/nix`: a flake's source tree is fixed by the reference
# used to enter it, not by where its file sits. This form leaves the flake and
# its lock at `nix/` while making the repository the tree, so `nix/default.nix`
# can read the Rust crate at `../` in its default layout.
FLAKE_REF="path:$REPO_ROOT?dir=nix"
DEV_FLAKE_REF="path:$REPO_ROOT"
# The trials this lane drives. Named exactly rather than by pattern: a pattern
# fails open, and a trial it missed would simply not run rather than error.
TRIALS='test(=workflow_06_exec_usage_surface) + test(=workflow_06_exec_exit_code_propagation) + test(=workflow_06_shell_interactive_session)'
PASS_COUNT=0
FAIL_COUNT=0
SKIP_COUNT=0
RECORD_COUNT=0

if [[ -t 1 && -z ${NO_COLOR:-} ]]; then
  GREEN=$'\033[32m'
  RED=$'\033[31m'
  YELLOW=$'\033[33m'
  BLUE=$'\033[34m'
  RESET=$'\033[0m'
else
  GREEN=
  RED=
  YELLOW=
  BLUE=
  RESET=
fi

pass() {
  PASS_COUNT=$((PASS_COUNT + 1))
  printf '%s[PASS]%s %s\n' "$GREEN" "$RESET" "$1"
}
fail() {
  FAIL_COUNT=$((FAIL_COUNT + 1))
  printf '%s[FAIL]%s %s\n' "$RED" "$RESET" "$1"
  # sed prefixes every line of multiline evidence.
  # shellcheck disable=SC2001
  [[ -n ${2:-} ]] && sed 's/^/       /' <<<"$2"
}
skip() {
  SKIP_COUNT=$((SKIP_COUNT + 1))
  printf '%s[SKIP]%s %s\n' "$YELLOW" "$RESET" "$1"
}
record() {
  RECORD_COUNT=$((RECORD_COUNT + 1))
  printf '%s[RECORD]%s %s\n' "$BLUE" "$RESET" "$1"
}

# `--clean` removes what the acceptance fixtures leave behind when a trial fails
# before its own teardown. Deliberately opt-in, for the same reason the sibling
# lanes make it opt-in: a failed run's roots are the evidence.
#
# Two names, because a fixture is split across two filesystems on purpose. The
# project tree and the volumes sit under the configured drive, and the runtime
# directory and its sockets sit under $XDG_RUNTIME_DIR, where the 108-byte socket
# limit is reachable. A cleaner that knew only the first would leave the second.
if [[ ${1:-} == --clean ]]; then
  removed=0
  for dir in "$("$SCRIPT_DIR/disk-preflight" --locate --images)"/vivarium-user-workflows-* \
    "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"/viv-t*; do
    [[ -d $dir ]] || continue
    rm -rf -- "$dir" && removed=$((removed + 1))
  done
  printf 'removed %d retained fixture root(s)\n' "$removed"
  exit 0
fi

# DUP: before anything writes. Ensure-running builds a guest closure and boots a
# microVM, twice over, and the honest moment to ask where those gigabytes go is
# while deferring is still free (AGENTS.md). `--images` rather than a scratch
# root, because the acceptance fixture resolves its own base from the same
# configured drive rather than from an inherited TMPDIR — so what this call does
# is ask the capacity question and refuse early, not redirect anything.
if ! "$SCRIPT_DIR/disk-preflight" --need 10 --images --label "the exec and shell lane" >/dev/null; then
  printf '\n0 passed, 0 failed, 0 skipped (nothing ran: disk preflight refused)\n'
  exit 1
fi

printf 'Evaluation tier\n'

if ! command -v nix >/dev/null 2>&1; then
  skip "launch contract builds: nix is unavailable"
  skip "the launch specification carries what a session reads: nix is unavailable"
  contract_ok=
else
  system=$(nix eval --raw --impure --expr builtins.currentSystem 2>/dev/null)
  build_log=$(nix build --no-link --print-out-paths "$FLAKE_REF#checks.$system.first-microvm" 2>&1)
  build_status=$?
  if ((build_status == 0)); then
    pass "launch contract builds: $(tail -n1 <<<"$build_log")"
    contract_ok=1
  else
    fail "launch contract builds (exit $build_status)" "$build_log"
    contract_ok=
  fi

  # The contract check above compares the launcher's own JSON against the guest's
  # own fstab and set-environment, which is what proves these three facts are the
  # guest's rather than a host constant restated. What is asserted here is the
  # other half: that a *rendered* specification — the file `viv exec` actually
  # reads out of the runtime directory — carries them through the launcher's jq.
  if [[ -n $contract_ok ]]; then
    runner_out=$(nix build --no-link --print-out-paths "$FLAKE_REF#first-microvm" 2>&1)
    runner="$(tail -n1 <<<"$runner_out")/bin/vivarium-first-microvm"
    if [[ -x $runner ]]; then
      spec_root=$(mktemp -d "${TMPDIR:-/tmp}/viv-exec-spec-XXXXXX")
      spec_log=$("$runner" --workspace "$REPO_ROOT" --runtime-dir "$spec_root/rt" \
        --volume-dir "$spec_root/volumes" --supervisor "$(command -v env)" \
        --uid "$(id -u)" --gid "$(id -g)" --memory-mib 2048 --vcpu 2 \
        --project-id p --target default --print-static-arguments 2>&1)
      spec_status=$?
      if ((spec_status == 0)); then
        missing_fields=()
        [[ $(jq -r '.runtimePaths.lock' <<<"$spec_log") == "$spec_root/rt/lock" ]] \
          || missing_fields+=("the startup lock is not an exact child of the runtime directory")
        # `.source`, not `.mountPoint`. Since ADR-0100 a session starts at the
        # host's own path, which the guest binds the share to at boot; `.mountPoint`
        # is the share's internal mount and would pass this check while telling
        # nothing about the cwd `viv exec` actually sends.
        [[ $(jq -r '.shares[] | select(.tag == "workspace") | .source' <<<"$spec_log") == "$REPO_ROOT" ]] \
          || missing_fields+=("the workspace share does not mirror this repository's own path")
        [[ -n $(jq -r '.guestSession.path' <<<"$spec_log") ]] \
          || missing_fields+=("the guest session carries no PATH")
        [[ $(jq -r '.guestSession.user' <<<"$spec_log") != root ]] \
          || missing_fields+=("the default guest user is root")
        if ((${#missing_fields[@]})); then
          fail "the launch specification carries what a session reads" "$(printf '%s\n' "${missing_fields[@]}")"
        else
          pass "the launch specification carries what a session reads"
          record "guest cwd: $(jq -r '.shares[] | select(.tag == "workspace") | .source' <<<"$spec_log")"
          record "workspace share internal mount: $(jq -r '.shares[] | select(.tag == "workspace") | .mountPoint' <<<"$spec_log")"
          record "guest session user: $(jq -r '.guestSession.user' <<<"$spec_log")"
          record "guest session PATH: $(jq -r '.guestSession.path' <<<"$spec_log")"
        fi
      else
        fail "the launch specification carries what a session reads (exit $spec_status)" "$spec_log"
      fi
      rm -rf -- "$spec_root"
    else
      fail "the launch specification carries what a session reads" "no runner at $runner"
    fi
  else
    skip "the launch specification carries what a session reads: the contract did not build"
  fi
fi

printf '\nHost tier\n'
missing=()
[[ $(uname -s 2>/dev/null) == Linux ]] || missing+=("Linux")
[[ -r /dev/kvm && -w /dev/kvm ]] || missing+=("/dev/kvm openable read/write")
systemctl --user show-environment >/dev/null 2>&1 || missing+=("usable systemd user manager")
[[ -n ${XDG_RUNTIME_DIR:-} && ${XDG_RUNTIME_DIR:-} = /* && -d ${XDG_RUNTIME_DIR:-/nonexistent} && -w ${XDG_RUNTIME_DIR:-/nonexistent} ]] || missing+=("absolute writable XDG_RUNTIME_DIR")
[[ -n $contract_ok ]] || missing+=("a launch contract that builds")

if ((${#missing[@]})); then
  reason=$(
    IFS=', '
    echo "${missing[*]}"
  )
  skip "exec and shell lane (run 1): missing prerequisites: $reason"
  skip "exec and shell lane (run 2): missing prerequisites: $reason"
else
  for attempt in 1 2; do
    # `--success-output=immediate` for the reason the sibling lane gives: nextest
    # replays a trial's output only on failure by default, so any figure a green
    # run measured would survive exactly the runs that produce no trustworthy
    # numbers.
    started=$SECONDS
    lane_log=$(
      cd -- "$REPO_ROOT" \
        && nix develop "$DEV_FLAKE_REF" --command \
          cargo nextest run --test user_workflows --run-ignored=all \
          --success-output=immediate -E "$TRIALS" 2>&1
    )
    lane_status=$?
    if ((lane_status == 0)); then
      pass "exec and shell lane (run $attempt)"
    else
      fail "exec and shell lane (run $attempt) (exit $lane_status)" "$lane_log"
    fi
    record "run $attempt wall clock: $((SECONDS - started))s"
    while IFS= read -r line; do
      record "run $attempt ${line#*\[RECORD\] }"
    done < <(grep -F '[RECORD]' <<<"$lane_log" || true)
  done
fi

printf '\nSummary\n'
printf 'PASS=%d FAIL=%d SKIP=%d RECORD=%d\n' "$PASS_COUNT" "$FAIL_COUNT" "$SKIP_COUNT" "$RECORD_COUNT"
if ((FAIL_COUNT == 0)); then
  printf 'VERDICT: PASS (RECORD findings are measurements; SKIPs require a capable host)\n'
  exit 0
else
  printf 'VERDICT: FAIL (%d hard check(s) failed)\n' "$FAIL_COUNT"
  exit 1
fi
