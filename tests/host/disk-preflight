#!/usr/bin/env bash

# Decide where a disk-heavy run puts its bytes, before it writes any of them.
#
# Building an image, realising a NixOS closure, or filling a store measures in
# gigabytes, and the failure mode when the disk is short is not a clean refusal.
# It is a write error somewhere in the middle: a half-fetched input, a lane that
# reports a product defect it did not find, and a workspace nobody can tell apart
# from a broken change. That happened here — a full `/nix` made `nix flake
# archive` fail silently, the harness fell back to resolving live, and the
# measurement that followed described the fallback rather than the product.
#
# So the question is asked first and answered once, while deferring is still
# free. The caller declares what it needs; this decides where it goes.
#
#   scratch=$(tests/host/disk-preflight --need 6 --label "guest system build") || exit 1
#   [[ -n $scratch ]] && export TMPDIR="$scratch"
#
# A lane that creates disk images rather than scratch asks the same question in
# the other mode, and gets the root to hang them off. It names its own
# subdirectories, because only the lane knows which of them it shares:
#
#   root=$(tests/host/disk-preflight --need 6 --label bench --images) || exit 1
#   TEMP_BASE=$root/bench
#   VOLUME_DIR=$root/diagnostics
#
# `--locate` answers either question for a cleanup or help path — with `--images`
# for the image root, without it for the scratch root — and does so with no
# capacity gate, no prompt, and nothing on stderr.
#
# `--require-drive` is for a caller that cannot use the host-disk fallback, which
# is every gated check: it makes a missing drive a prompt or a refusal rather
# than a notice. `tests/host/heavy-run` is what the hooks call, and it asks here.
#
# stdout carries the directory to use and nothing else, so a caller can capture
# it. Everything a human reads goes to stderr.
#
# `VIVARIUM_HEAVY_DRIVE` is the answer given in advance: point it at a directory
# that already exists on the drive that should absorb this, and no prompt
# appears. Already exists, because this never creates it — see the note above the
# validation below for why creating it is what breaks the check. It is read from
# the environment first and from the repository's untracked `.envrc.local`
# second, so a developer answers once per machine rather than once per shell —
# and a lane invoked outside a direnv shell, which is how an agent runs one,
# still gets the answer. Without a usable drive, a terminal is asked and a
# non-interactive run is refused rather than guessed for; an automated lane that
# silently filled the boot disk is the outcome this exists to prevent.
#
# A configured drive that is absent, unwritable, or short is a fallback and not a
# failure — an external disk gets unplugged, and that should cost a notice rather
# than a run. What it must never cost is silence: the reason is named on stderr
# and the run then faces the ordinary short-disk decision on the host disk.
#
# `--require-drive` is that same decision with the default the other way round,
# and it exists because a gated run is not a hand-run lane. Nothing about a
# fallback is wrong when a person watching the terminal chose to start something;
# it is wrong when the caller is a git hook nobody is reading, because then the
# boot disk absorbs a booting test suite and the first anyone hears of it is a
# full filesystem. Under the flag the fallback becomes what it would have been if
# someone were there to ask: a prompt with a terminal, and a refusal without one.
#
# One thing it deliberately cannot promise: the Nix store's own location. A
# closure lands in the store this daemon serves, and moving that is a machine
# decision, not a lane's. What this moves is build scratch and image roots; what
# it does about the store is refuse, in either mode, to start a run that will not
# fit in it.

set -u

SCRIPT_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)
REPO_ROOT=$(CDPATH='' cd -- "$SCRIPT_DIR/../.." && pwd -P)

NEED_GIB=0
LABEL="this run"
IMAGES=0
LOCATE=0
REQUIRE_DRIVE=0
# Enough headroom that a run finishing exactly at the line still leaves the host
# usable. A disk at literally zero takes more than the build down with it.
MARGIN_GIB=2

# An option that takes an operand checks that one is there before shifting past
# it. `shift 2` with a single argument left shifts nothing and returns non-zero,
# and with no `set -e` the loop then re-reads the same option forever — a typo at
# a prompt becomes a hook that hangs instead of a usage error.
need_operand() {
  (($1 >= 2)) && return 0
  printf 'disk-preflight: %s needs a value\n' "$2" >&2
  exit 64
}

# A requirement is a quantity, so it is checked as one before it becomes a
# threshold. `REQUIRED` is built by arithmetic, and arithmetic accepts what the
# caller meant as a number without asking whether it is one: `--need -100` makes
# every free-space comparison true and turns the whole preflight into a formality
# that reports success, while a non-numeric value expands to an unbound variable
# in the middle of the run. Both are the shape this repository calls inert rather
# than absent — a gate still present, still logging, and no longer deciding.
need_quantity() {
  [[ $1 =~ ^[0-9]+$ ]] && return 0
  printf 'disk-preflight: --need takes whole gibibytes, not %s\n' "$1" >&2
  exit 64
}

while (($#)); do
  case "$1" in
    --need)
      need_operand $# --need
      need_quantity "$2"
      NEED_GIB=$2
      shift 2
      ;;
    --label)
      need_operand $# --label
      LABEL=$2
      shift 2
      ;;
    --images)
      IMAGES=1
      shift
      ;;
    --locate)
      LOCATE=1
      shift
      ;;
    --require-drive)
      REQUIRE_DRIVE=1
      shift
      ;;
    *)
      printf 'disk-preflight: unknown argument %s\n' "$1" >&2
      exit 64
      ;;
  esac
done

note() { printf '%s\n' "$1" >&2; }

# Free gibibytes on the filesystem holding a path, or 0 when it cannot be read.
free_gib() {
  local path=$1
  while [[ -n $path && ! -e $path ]]; do
    path=$(dirname -- "$path")
  done
  df -PB1G -- "$path" 2>/dev/null | awk 'NR == 2 { print $4 + 0 }'
}

# N24 (`src/launch/spec.rs`) refuses a workspace source that resolves to /tmp or
# /var/tmp, or to any ancestor of them, and three of the lanes that ask for a
# base hand that directory to the launcher as the workspace. A drive pointed
# there produces a refusal from the product, one boot later, in a vocabulary that
# says nothing about the disk.
under_temp() {
  local path=$1
  case "$path" in
    /tmp | /tmp/* | /var/tmp | /var/tmp/* | / | /var) return 0 ;;
    *) return 1 ;;
  esac
}

STORE=${NIX_STORE_DIR:-/nix/store}
SCRATCH=${TMPDIR:-/tmp}
STATE_HOME=${XDG_STATE_HOME:-$HOME/.local/state}
REQUIRED=$((NEED_GIB + MARGIN_GIB))

# The answer given in advance, from the environment or from the developer's own
# untracked file. Sourced in a subshell with its output discarded: the file is
# documented as plain exports, but a lane must not inherit whatever else someone
# put there, and a file that fails to source is worth no drive rather than a
# dead run.
drive=${VIVARIUM_HEAVY_DRIVE:-}
drive_from_file=0
if [[ -z $drive && -f $REPO_ROOT/.envrc.local ]]; then
  drive=$(
    # shellcheck disable=SC1091
    . "$REPO_ROOT/.envrc.local" >/dev/null 2>&1 || exit 0
    printf '%s' "${VIVARIUM_HEAVY_DRIVE:-}"
  )
  [[ -n $drive ]] && drive_from_file=1
fi

# `--locate` answers where a lane's bytes live without gating on capacity and
# without asking anything. It exists for the cleanup and help paths, which read
# and remove rather than write: refusing to tell a cleaner where the bytes are
# because the disk is full would withhold the answer exactly when it is needed.
# Silence is right here for the same reason — nothing is being written, so there
# is no decision for an operator to make.
#
# Composed with `--require-drive` it answers the narrower question: the drive, or
# nothing and a non-zero status. That is what a caller asks when a fallback would
# be the wrong answer rather than a lesser one — the dev shell picking a compile
# cache, say, where the state root is not a second-best location, just a
# different one nobody asked for.
if ((LOCATE == 1)); then
  if [[ -n $drive && -d $drive && -w $drive ]] \
    && { ((IMAGES == 0)) || ! under_temp "$drive"; }; then
    printf '%s\n' "$drive"
  elif ((REQUIRE_DRIVE == 1)); then
    exit 1
  elif ((IMAGES == 1)); then
    printf '%s\n' "$STATE_HOME/vivarium"
  else
    printf '%s\n' "$SCRATCH"
  fi
  exit 0
fi

store_free=$(free_gib "$STORE")
scratch_free=$(free_gib "$SCRATCH")

note "disk-preflight: $LABEL needs about ${NEED_GIB}G, plus ${MARGIN_GIB}G headroom"
note "  store   $STORE: ${store_free}G free"
if ((IMAGES == 0)); then
  note "  scratch $SCRATCH: ${scratch_free}G free"
fi
((drive_from_file == 1)) && note "  drive named by .envrc.local"

# What a rejected drive costs, which is the one thing the two modes disagree
# about. Ordinarily the run continues on the host disk, so the reason is a
# notice; under `--require-drive` the reason is the first half of a refusal, and
# promising a fallback there would describe something that is not about to
# happen.
drive_rejected() {
  if ((REQUIRE_DRIVE == 1)); then
    note "disk-preflight: $1"
  else
    note "disk-preflight: $1; falling back to this disk"
  fi
}

# A directory a person typed at one of the prompts below, held to the same
# standard as a configured drive: existing, writable, wide enough, and — in
# `--images` mode — not somewhere N24 would refuse as a workspace one boot later.
# Every prompt in this file accepts the same answer, so the checking lives once.
#
# Existing, on the same grounds as the configured drive above and not as a
# separate rule. The likeliest thing to type at this prompt is the drive that was
# just refused, and creating it would rebuild that path on the boot filesystem
# and hand back the answer the operator was trying to avoid — the original
# failure, reached by typing instead of by configuring.
accept_answer_dir() {
  local candidate=$1 candidate_free
  if ((IMAGES == 1)) && under_temp "$candidate"; then
    note "disk-preflight: $candidate is under a temp root, which N24 refuses; nothing was run"
    exit 69
  fi
  if [[ ! -d $candidate ]]; then
    note "disk-preflight: $candidate does not exist; create it on the drive first. Nothing was run"
    exit 69
  fi
  if [[ ! -w $candidate ]]; then
    note "disk-preflight: $candidate is not a writable directory; nothing was run"
    exit 69
  fi
  candidate_free=$(free_gib "$candidate")
  if ((candidate_free < REQUIRED)); then
    note "disk-preflight: $candidate has ${candidate_free}G, short of ${REQUIRED}G; nothing was run"
    exit 69
  fi
}

# Validated rather than trusted: a drive that is not mounted looks exactly like
# an empty directory, and writing the run into the mountpoint of an absent disk
# is the same failure with extra steps.
#
# Which is why the directory has to already be there. Creating it is what defeats
# the check: `mkdir -p` on the mountpoint of an unplugged disk succeeds against
# the boot filesystem, the capacity check then measures the boot disk, and the
# gate cheerfully sends a booting test suite to the exact place it exists to keep
# it out of. So the drive is configured once by hand — the guide's setup step —
# and never conjured here.
#
# What existence proves depends on where the variable points, which is why the
# guide says to point it under the mount rather than at it. A subdirectory of a
# mounted filesystem goes away with it, so its absence is the drive's absence. A
# mountpoint the system keeps around either way — an `/etc/fstab` entry, as
# against a path a mount helper creates and removes — is still there unmounted,
# and this check passes on the boot filesystem underneath it. Closing that needs
# filesystem identity rather than existence, and is not done here.
drive_ok=0
if [[ -n $drive ]]; then
  if [[ ! -d $drive ]]; then
    drive_rejected "VIVARIUM_HEAVY_DRIVE=$drive does not exist; the drive is unplugged, or the directory was never created"
  elif [[ ! -w $drive ]]; then
    drive_rejected "VIVARIUM_HEAVY_DRIVE=$drive is not a writable directory"
  elif ((IMAGES == 1)) && under_temp "$drive"; then
    drive_rejected "VIVARIUM_HEAVY_DRIVE=$drive is under a temp root, which N24 refuses as a workspace"
  else
    drive_free=$(free_gib "$drive")
    note "  drive   $drive: ${drive_free}G free"
    if ((drive_free < REQUIRED)); then
      drive_rejected "$drive has ${drive_free}G, short of the ${REQUIRED}G this needs"
    else
      drive_ok=1
    fi
  fi
elif ((REQUIRE_DRIVE == 1)); then
  note 'disk-preflight: VIVARIUM_HEAVY_DRIVE names no drive, in the environment or in .envrc.local'
fi

# The requirement, decided before either mode picks a directory so that both
# modes get the same answer. A terminal is asked, because a person who is there
# can point at another disk or accept this one; a run with no terminal is refused
# rather than guessed for, which is what makes this usable from a git hook.
if ((REQUIRE_DRIVE == 1 && drive_ok == 0)); then
  note "disk-preflight: $LABEL is gated on a drive and there is no usable one."
  if [[ ! -t 0 ]]; then
    note "  Nothing was run. Point VIVARIUM_HEAVY_DRIVE at a directory on a drive with"
    note "  ${REQUIRED}G free, or state that this run belongs on the host disk."
    exit 69
  fi
  note "  Enter a directory on another drive to use, or:"
  note "    'here' to run on the current disk anyway"
  note "    'defer' to stop now and set a drive up first"
  printf '  path/here/defer> ' >&2
  read -r required_answer
  case "$required_answer" in
    here)
      note "disk-preflight: proceeding on the current disk at your say-so"
      ;;
    defer | '' | q | quit)
      note "disk-preflight: deferred; nothing was run"
      exit 75
      ;;
    *)
      accept_answer_dir "$required_answer"
      drive="$required_answer"
      drive_ok=1
      ;;
  esac
fi

# Worth saying plainly rather than proceeding into it: the drive can hold the
# bytes this moves, and cannot hold the closure. Moving one does not answer for
# the other, and every lane that asks here also realises something into the
# store, so a short store is a refusal in both modes rather than a warning in one.
store_gate() {
  ((store_free >= REQUIRED)) && return 0
  if ((drive_ok == 1)); then
    note "disk-preflight: the drive takes what this moves, but the closure still lands in $STORE,"
    note "                which has ${store_free}G free."
  fi
  note "disk-preflight: free space in $STORE or expect this to fail; it has ${store_free}G."
  if [[ ! -t 0 ]]; then
    note "  Nothing was run. The store cannot be moved by this."
    exit 69
  fi
  note "  'here' to run anyway, anything else to stop now."
  printf '  here/defer> ' >&2
  read -r store_answer
  if [[ $store_answer == here ]]; then
    note "disk-preflight: proceeding at your say-so"
    return 0
  fi
  note "disk-preflight: deferred; nothing was run"
  exit 75
}

# `--images` mode: the root a lane hangs its disk images off. Deliberately not
# under $TMPDIR even when falling back — /tmp is a tmpfs on an ordinary Linux
# desktop, and a sparse image declared in tens of gibibytes belongs on a real
# filesystem. The fallback is the state root, which is both what these lanes used
# before this had a mode for it and the filesystem the launcher would have used.
if ((IMAGES == 1)); then
  if ((drive_ok == 1)); then
    root="$drive"
  else
    root="$STATE_HOME/vivarium"
    root_free=$(free_gib "$root")
    note "  images  $root: ${root_free}G free"
    if ((root_free < REQUIRED)); then
      note "disk-preflight: not enough room for $LABEL under $root."
      if [[ ! -t 0 ]]; then
        note "  Nothing was run. Set VIVARIUM_HEAVY_DRIVE to a directory on a drive with"
        note "  ${REQUIRED}G free and start again, or free space where the state root lives."
        exit 69
      fi
      note "  Enter a directory on another drive to use, or:"
      note "    'here' to run on the current disk anyway"
      note "    'defer' to stop now and set a drive up first"
      printf '  path/here/defer> ' >&2
      read -r answer
      case "$answer" in
        here)
          note "disk-preflight: proceeding on the current disk at your say-so"
          ;;
        defer | '' | q | quit)
          note "disk-preflight: deferred; nothing was run"
          exit 75
          ;;
        *)
          accept_answer_dir "$answer"
          root="$answer"
          ;;
      esac
    fi
  fi
  if ! mkdir -p -- "$root" 2>/dev/null || [[ ! -w $root ]]; then
    note "disk-preflight: cannot create $root; nothing was run"
    exit 69
  fi
  store_gate
  note "disk-preflight: $LABEL puts its images under $root"
  printf '%s\n' "$root"
  exit 0
fi

# Scratch mode. A usable drive answers for the scratch half regardless of what
# the host disk holds; only the store can still refuse the run.
if ((drive_ok == 1)); then
  store_gate
  printf '%s\n' "$drive"
  exit 0
fi

if ((store_free >= REQUIRED && scratch_free >= REQUIRED)); then
  printf '\n'
  exit 0
fi

note "disk-preflight: not enough room for $LABEL on the current disk."

if [[ ! -t 0 ]]; then
  note "  Nothing was run. Set VIVARIUM_HEAVY_DRIVE to a directory on a drive with"
  note "  ${REQUIRED}G free and start again, or free space where the store lives."
  exit 69
fi

note "  Enter a directory on another drive to use for scratch, or:"
note "    'here' to run on the current disk anyway"
note "    'defer' to stop now and set a drive up first"
printf '  path/here/defer> ' >&2
read -r answer

case "$answer" in
  here)
    note "disk-preflight: proceeding on the current disk at your say-so"
    printf '\n'
    exit 0
    ;;
  defer | '' | q | quit)
    note "disk-preflight: deferred; nothing was run"
    exit 75
    ;;
  *)
    accept_answer_dir "$answer"
    note "disk-preflight: scratch goes to $answer"
    printf '%s\n' "$answer"
    exit 0
    ;;
esac
