#!/usr/bin/env bash
# Put a developer build of `viv` on this machine's PATH.
#
# `cargo install` and not a symlink into the build directory: the installed
# command is then a real binary with a name cargo also knows how to remove, and
# it cannot be left dangling by a `cargo clean` or caught half-written by a
# concurrent build.
#
# What it installs is what a user would get — a `viv` whose baseline inputs
# resolve live, per `src/config/flake.rs`. That is right for checking the
# command surface and wrong for checking a guest, because the guest would be
# built from the published branch rather than from this tree. `--pinned` is the
# second entry point for that case; see `docs/guides/develop-and-install.md`.
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd -- "$script_dir/.." && pwd)"

bin_dir="${CARGO_HOME:-$HOME/.cargo}/bin"
wrapper="$bin_dir/viv-dev"

mode=install
case "${1-}" in
  --pinned) mode=pinned ;;
  --uninstall) mode=uninstall ;;
  "") ;;
  *)
    # The backticks quote an identifier the way every other diagnostic here does;
    # they are not a substitution, and the format string must stay single-quoted
    # so the argument reaches `%s` rather than the format.
    # shellcheck disable=SC2016
    printf 'install-dev: unknown argument `%s`; expected --pinned or --uninstall\n' "$1" >&2
    exit 2
    ;;
esac

if [[ $mode == uninstall ]]; then
  rm -f -- "$wrapper"
  cargo uninstall vivarium
  printf '==> removed viv, vivarium-supervisor and viv-dev from %s\n' "$bin_dir"
  exit 0
fi

printf '==> cargo install --path %s\n' "$repo_root"
cargo install --path "$repo_root" --locked --force

# The one failure mode this recipe has: the install succeeds and the command is
# still not found, because cargo's bin directory was never on PATH. Say so
# rather than leaving the developer to discover it at the next prompt.
printf '==> installed viv and vivarium-supervisor into %s\n' "$bin_dir"
case ":$PATH:" in
  *":$bin_dir:"*) ;;
  *) printf 'install-dev: %s is not on PATH; add it or the command will not be found\n' "$bin_dir" >&2 ;;
esac

[[ $mode == pinned ]] || exit 0

# The pinned entry point. It bakes the repository path, which is stable, and
# recomputes the store paths on every invocation, because those move whenever
# `nix/flake.lock` does — a wrapper that baked them would go stale against the
# lock without saying so.
#
# A separate name rather than a shadowed `viv`: the plain command stays exactly
# what a user gets, so there is never a question about which one a given
# observation came from.
cat >"$wrapper" <<EOF
#!/usr/bin/env bash
# Generated by scripts/install-dev --pinned. Regenerate rather than edit.
# Runs the installed \`viv\` against $repo_root instead of the published branch.
set -euo pipefail
eval "\$("$repo_root/scripts/baseline-pins")"
exec "$bin_dir/viv" "\$@"
EOF
chmod +x -- "$wrapper"
printf '==> installed viv-dev into %s, pinned to %s\n' "$bin_dir" "$repo_root"
