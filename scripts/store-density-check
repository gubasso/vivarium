#!/usr/bin/env bash

# Measure what a Nix store's *density* actually is, and read the store volume's
# inode table directly. Two questions, both host-only, neither needing a boot.
#
# WHY THIS IS A SEPARATE SCRIPT, and not more checks in `first-microvm-check`:
# nothing here boots a guest or needs /dev/kvm. Both measurements are arithmetic
# over the host's own store plus one `mkfs` of a throwaway image, so they run in
# minutes on any machine with Nix and answer questions that the microVM lane was
# structurally unable to answer — see the METHOD note below.
#
# METHOD, and it is the whole design:
#
#   ADR-0091 provisions the store volume at one inode per 8192 bytes, argued from
#   a single host store's aggregate density of "one inode per 11 KiB". An
#   aggregate is the wrong statistic to bet a provisioning ratio on. A store
#   whose bytes are dominated by a handful of enormous paths (a Rust toolchain
#   measures ~287 KiB per inode) reports a comfortable aggregate while the
#   *typical* path it will actually accumulate sits far below it. So this script
#   reports the distribution — aggregate AND p10/median/p90 — over three
#   populations, and the spread between them is the finding.
#
#   ADR-0091 also flags a hazard it could only watch for indirectly: `mkfs.ext4`
#   may leave the inode table lazily initialised, in which case the kernel zeroes
#   it in the background after first mount and a sparse image gains around a
#   gibibyte with the guest writing nothing — against ADR-0037's sparse promise.
#   The spike inferred "it did not happen" from allocated-block samples over
#   three-minute VMs. `dumpe2fs -h` answers it *directly*, before any mount, by
#   reading the filesystem's own feature flags.
#
# STATED GAP: this script measures the HOST's store, and the guest's store is not
# the host's. Two divergences are known and are recorded as findings rather than
# corrected for, because neither can be measured from here:
#   * the host store is hardlink-deduplicated through /nix/store/.links, so its
#     inode count is optimistically LOW;
#   * the guest masks .links with a tmpfs (ADR-0092), so the guest can never
#     dedup and its realised density should be WORSE than whatever is measured
#     here — which is the direction ADR-0091 needs to worry about.
# The guest-side number needs a workload in a guest; that is the pressure lane's
# job, not this one's.
#
# Output is one `[PASS]`/`[FAIL]`/`[SKIP]`/`[RECORD]` line per check plus a
# verdict. A `[SKIP]` means *unproven*, never *absent*. A `[RECORD]` is a
# measurement, not a judgement — and in this script the RECORDs *are* the point;
# the PASSes only assert that the measurement could be taken at all.

# DUP: no `set -euo pipefail`. Every check captures its own exit status and turns
# it into a result line; a failing check must not abort the run.

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
REPO_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd -P)
SYSTEM=$(nix eval --raw --impure --expr builtins.currentSystem 2>/dev/null || uname -m | sed 's/$/-linux/')
# The microVM is its own flake under `nix/`, not an output of the repository
# root's. The root flake is the development environment — Rust toolchain,
# pre-commit runtimes, the devShell direnv activates — and carries no product
# input or output. `path:` form so the write-mode file set is included without
# git operations.
# `?dir=nix` rather than `/nix` so the repository is the flake's source tree and
# the product build can read the Rust crate in its default layout; see
# docs/reference/microvm-verification-harness.md.
FLAKE_REF="path:$REPO_ROOT?dir=nix"
# The devShell lives in the repository root's flake, which is the *other* flake
# and the only one that has one. Population 3 below asked the product flake for a
# `devShells` output it has never had, so it could only ever skip.
DEV_FLAKE_REF="path:$REPO_ROOT"
PASS_COUNT=0
FAIL_COUNT=0
SKIP_COUNT=0
RECORD_COUNT=0

SAMPLE_SIZE=${VIVARIUM_DENSITY_SAMPLE:-300}

# NOT under $TMPDIR. This script creates an image that DECLARES 32 GiB, and /tmp
# is a tmpfs on an ordinary Linux desktop — if `mkfs.ext4` turns out to write the
# inode table eagerly, that is ~1 GiB of *RAM*, which is both a bad surprise and
# a confound for the very question being asked. The state home is backed by a
# real filesystem, which is also the filesystem the launcher would have used.
STATE_HOME=${XDG_STATE_HOME:-$HOME/.local/state}
VOLUME_DIR=$STATE_HOME/vivarium/diagnostics
TEMP_BASE=${VIVARIUM_DENSITY_TEMP_BASE:-$STATE_HOME/vivarium/density}
mkdir -p "$TEMP_BASE" "$VOLUME_DIR" 2>/dev/null
TEMP_ROOT=$(mktemp -d "$TEMP_BASE/run.XXXXXX" 2>/dev/null || true)
if [[ -z $TEMP_ROOT ]]; then
  printf '[FAIL] cannot create a private scratch directory under %s\n' "$TEMP_BASE" >&2
  exit 1
fi
PROBE_IMAGE=$TEMP_ROOT/inode-table-probe.img

# DUP
if [[ -t 1 && -z ${NO_COLOR:-} ]]; then
  GREEN=$'\033[32m'; RED=$'\033[31m'; YELLOW=$'\033[33m'; BLUE=$'\033[34m'; RESET=$'\033[0m'
else
  GREEN=; RED=; YELLOW=; BLUE=; RESET=
fi

# DUP
pass() { PASS_COUNT=$((PASS_COUNT + 1)); printf '%s[PASS]%s %s\n' "$GREEN" "$RESET" "$1"; }
fail() { FAIL_COUNT=$((FAIL_COUNT + 1)); printf '%s[FAIL]%s %s\n' "$RED" "$RESET" "$1"; [[ -n ${2:-} ]] && sed 's/^/       /' <<<"$2"; }
skip() { SKIP_COUNT=$((SKIP_COUNT + 1)); printf '%s[SKIP]%s %s\n' "$YELLOW" "$RESET" "$1"; }
record() { RECORD_COUNT=$((RECORD_COUNT + 1)); printf '%s[RECORD]%s %s\n' "$BLUE" "$RESET" "$1"; }

# DUP: every check this script can emit, in order. Named in one place so a run
# that skips wholesale reports the same inventory as a run that completes — a
# shorter list would read as "fewer things went wrong".
ALL_CHECKS=(
  store-density-nix-present
  store-density-dedup-posture
  store-density-host-store-sample
  store-density-runner-closure
  store-density-devshell-closure
  store-density-verdict-against-adr0091
  store-density-mkfs-argv-matches-runner
  store-density-inode-table-lazy
  store-density-probe-image-removed
  store-density-cleanup
)

# DUP: `last` is optional and inclusive.
skip_remaining() {
  local reason=$1 first=$2 last=${3:-} seen=no check
  for check in "${ALL_CHECKS[@]}"; do
    [[ $check == "$first" ]] && seen=yes
    [[ $seen == yes ]] && skip "$check: $reason"
    [[ -n $last && $check == "$last" ]] && break
  done
}

cleanup() {
  # The probe image lives inside TEMP_ROOT precisely so that this one line is
  # enough. It declares 32 GiB; it must not be able to survive the run that
  # exists to find out whether creating it costs a gibibyte.
  [[ -n ${TEMP_ROOT:-} && -d $TEMP_ROOT ]] && rm -rf -- "$TEMP_ROOT"
  rmdir "$TEMP_BASE" 2>/dev/null
}
trap cleanup EXIT INT TERM

# DUP: see `first-microvm-check` for why `--clean` is opt-in. This lane retains
# nothing by design — its scratch base is removed on every exit — so `--clean`
# exists only to collect a base left behind by a killed run.
clean_lane() {
  local removed=0 dir
  for dir in "$TEMP_BASE"/run.*; do
    [[ -d $dir ]] || continue
    [[ $dir == "$TEMP_ROOT" ]] && continue
    printf 'removing %s\n' "$dir"
    rm -rf -- "$dir" && removed=$((removed + 1))
  done
  printf 'clean: removed=%d kept-live=0\n' "$removed"
}

if [[ ${1:-} == --clean ]]; then
  # Remove this invocation's own scratch directory FIRST. The EXIT trap would do
  # it, but only after `clean_lane` has already tried to rmdir the base it sits
  # in — which is why a `--clean` run used to leave the empty base behind.
  cleanup
  clean_lane
  exit 0
fi

printf 'vivarium store density check (ADR-0089/ADR-0091 measurement, host-only)\n'
printf '  repo:      %s\n' "$REPO_ROOT"
printf '  system:    %s\n' "$SYSTEM"
printf '  scratch:   %s\n' "$TEMP_ROOT"
printf '  kernel:    %s\n' "$(uname -r)"
printf '  nix:       %s\n' "$(nix --version 2>/dev/null || echo absent)"
printf '  sample:    %s host store paths\n' "$SAMPLE_SIZE"
printf 'NOTE: this measures the HOST store. The guest cannot deduplicate (ADR-0092),\n'
printf '      so the guest'"'"'s realised density should be WORSE than anything here.\n'
printf 'NOTE: no boot, no /dev/kvm. Nothing here describes guest runtime behaviour.\n\n'

printf -- '--- evaluation tier -----------------------------------------------------\n'

if ! command -v nix >/dev/null 2>&1; then
  for check in "${ALL_CHECKS[@]}"; do fail "$check: Nix is absent"; done
  printf '\nSummary\nPASS=%d FAIL=%d SKIP=%d RECORD=%d\n' "$PASS_COUNT" "$FAIL_COUNT" "$SKIP_COUNT" "$RECORD_COUNT"
  printf 'VERDICT: FAIL (%d hard check(s) failed)\n' "$FAIL_COUNT"
  exit 1
fi
pass "store-density-nix-present: $(nix --version)"

# The dedup posture is not a detail: if store optimisation is on and .links is
# populated, every hardlinked duplicate is one inode on this host and would be
# N inodes in a guest that cannot dedup. Recording it is what makes the host
# number interpretable as a *lower bound* rather than as an estimate.
auto_optimise=$(nix config show auto-optimise-store 2>/dev/null || nix show-config 2>/dev/null | sed -n 's/^auto-optimise-store = //p')
links_entries=$(find /nix/store/.links -maxdepth 1 -mindepth 1 -printf '.' 2>/dev/null | wc -c)
record "store-density-dedup-posture: auto-optimise-store=${auto_optimise:-unknown} host .links entries=$links_entries (the guest masks .links with tmpfs per ADR-0092 and can never dedup)"
pass "store-density-dedup-posture: the host's deduplication posture is on the record"

# ---------------------------------------------------------------------------
# Arm A — bytes per inode, as a distribution
# ---------------------------------------------------------------------------
#
# Per store path: sum the sizes of regular files, and count EVERY directory
# entry. Counting entries rather than `du`'s deduplicated inode count is the
# deliberate choice — a Nix store path is transferred and materialised as a NAR,
# and a NAR has no hardlink concept, so every link becomes its own file in the
# guest. `du --inodes` would count a hardlinked pair once and understate exactly
# the number this measurement exists to bound.
measure_paths() {
  local list=$1 out=$2
  : >"$out"
  local p bytes entries
  while IFS= read -r p; do
    [[ -e $p ]] || continue
    read -r bytes entries < <(
      find "$p" \( -type f -printf 'f %s\n' \) -o -printf 'o 0\n' 2>/dev/null \
        | awk '{ if ($1 == "f") b += $2; n++ } END { printf "%d %d\n", b + 0, n + 0 }'
    )
    ((entries > 0)) || continue
    printf '%s %s %s\n' "$bytes" "$entries" "$p" >>"$out"
  done <"$list"
}

# Aggregate is total bytes over total entries; the percentiles are over the
# per-path ratios. Reporting only the first would repeat ADR-0091's mistake.
#
# The percentiles go through `sort -n` rather than gawk's `asort`, which is a
# gawk-only extension: this script has no control over which awk is first in a
# contributor's PATH, and a silent mawk would turn the whole distribution — the
# entire point of Arm A — into an empty string.
summarise() {
  local out=$1
  local totals ratios
  totals=$(awk '{ b += $1; n += $2 } END { printf "%d %d %d %.0f", NR, b + 0, n + 0, (n > 0 ? b / n : 0) }' "$out")
  ratios=$(awk '{ printf "%.0f\n", ($2 > 0 ? $1 / $2 : 0) }' "$out" | sort -n)
  local count; count=$(wc -l <<<"$ratios")
  if [[ -z $ratios ]] || ((count == 0)); then printf 'paths=0'; return; fi
  local p10 p50 p90
  p10=$(sed -n "$(( count * 10 / 100 + 1 ))p" <<<"$ratios")
  p50=$(sed -n "$(( count * 50 / 100 + 1 ))p" <<<"$ratios")
  p90=$(sed -n "$(( count * 90 / 100 + 1 ))p" <<<"$ratios")
  # The p90 index can run one past the end for small samples.
  [[ -z $p90 ]] && p90=$(tail -n1 <<<"$ratios")
  [[ -z $p50 ]] && p50=$(tail -n1 <<<"$ratios")
  printf 'paths=%s bytes=%s entries=%s aggregate=%s p10=%s median=%s p90=%s' \
    $totals "$p10" "$p50" "$p90"
}

# Population 1 — a random sample of the host store.
# `.drv` files are excluded: each is a single small file, so a store full of them
# would drag the ratio toward zero for a reason that has nothing to do with how
# an output-heavy guest store grows. `.links` and `.lock` are not store paths.
find /nix/store -maxdepth 1 -mindepth 1 \
  ! -name '.links' ! -name '.lock' ! -name '*.drv' -print 2>/dev/null \
  | shuf -n "$SAMPLE_SIZE" >"$TEMP_ROOT/sample.list"
sample_n=$(wc -l <"$TEMP_ROOT/sample.list")
if ((sample_n == 0)); then
  skip "store-density-host-store-sample: the host store yielded no sampleable paths"
  host_summary=
else
  measure_paths "$TEMP_ROOT/sample.list" "$TEMP_ROOT/sample.data"
  host_summary=$(summarise "$TEMP_ROOT/sample.data")
  record "store-density-host-store-sample: $host_summary"
  pass "store-density-host-store-sample: measured $sample_n random host store paths"
fi

# Population 2 — the runner closure. This is the material the guest actually
# carries at boot, so it is the closest thing measurable from the host to "what
# a guest store is made of".
runner_out=$(nix build --no-link --print-out-paths "$FLAKE_REF#first-microvm" 2>"$TEMP_ROOT/build.err" | tail -n1)
if [[ -z $runner_out ]]; then
  skip "store-density-runner-closure: the runner could not be built"
  record "build stderr: $(tail -n 5 "$TEMP_ROOT/build.err" | tr '\n' '|' | tail -c 300)"
  runner_summary=
else
  nix-store -qR "$runner_out" >"$TEMP_ROOT/runner.list" 2>/dev/null
  measure_paths "$TEMP_ROOT/runner.list" "$TEMP_ROOT/runner.data"
  runner_summary=$(summarise "$TEMP_ROOT/runner.data")
  record "store-density-runner-closure: $runner_summary"
  pass "store-density-runner-closure: measured the first-microvm runner's full closure"
fi

# Population 3 — a dev shell's dependency closure, via `inputDerivation`. This is
# the shape of what a *user's* project pulls into the guest store, which is the
# growth ADR-0089's threshold is sized against.
shell_out=$(nix build --no-link --print-out-paths "$DEV_FLAKE_REF#devShells.$SYSTEM.default.inputDerivation" 2>"$TEMP_ROOT/shell.err" | tail -n1)
if [[ -z $shell_out ]]; then
  skip "store-density-devshell-closure: the devShell inputDerivation could not be realised"
  record "devshell stderr: $(tail -n 5 "$TEMP_ROOT/shell.err" | tr '\n' '|' | tail -c 300)"
  shell_summary=
else
  nix-store -qR "$shell_out" >"$TEMP_ROOT/shell.list" 2>/dev/null
  measure_paths "$TEMP_ROOT/shell.list" "$TEMP_ROOT/shell.data"
  shell_summary=$(summarise "$TEMP_ROOT/shell.data")
  record "store-density-devshell-closure: $shell_summary"
  pass "store-density-devshell-closure: measured this repo's devShell dependency closure"
fi

# The verdict this arm exists to produce. ADR-0091 provisions at 8192 bytes per
# inode; a population whose ratio is BELOW that exhausts inodes before it
# exhausts bytes, which is the failure ADR-0089's block-reading trigger is
# structurally unable to see.
if [[ -z $host_summary && -z $runner_summary && -z $shell_summary ]]; then
  skip "store-density-verdict-against-adr0091: no population could be measured"
else
  verdict=
  for pair in "host:$host_summary" "runner:$runner_summary" "devshell:$shell_summary"; do
    name=${pair%%:*}; body=${pair#*:}
    [[ -n $body ]] || continue
    agg=$(sed -n 's/.*aggregate=\([0-9]*\).*/\1/p' <<<"$body")
    med=$(sed -n 's/.*median=\([0-9]*\).*/\1/p' <<<"$body")
    [[ -n $agg && -n $med ]] || continue
    binds_agg=$( ((agg < 8192)) && echo inodes || echo bytes )
    binds_med=$( ((med < 8192)) && echo inodes || echo bytes )
    verdict+="$name: aggregate=$agg binds=$binds_agg; median=$med binds=$binds_med"$'\n'
  done
  record "store-density-verdict-against-adr0091: which limit binds first at -i 8192"$'\n'"$verdict"
  pass "store-density-verdict-against-adr0091: the aggregate-versus-median split is on the record"
fi

printf -- '\n--- inode table tier ----------------------------------------------------\n'

# ---------------------------------------------------------------------------
# Arm B — is the inode table left lazily initialised?
# ---------------------------------------------------------------------------
#
# The argv must be the launcher's own, not a plausible reconstruction: this arm
# is worthless if it measures a filesystem the product would not have created.
# Both numbers are read out of the built launcher's JSON, the same way the other
# harness scripts read their canary expressions, so the two cannot drift.
launcher_json=
if [[ -n $runner_out ]]; then
  launcher_json=$(grep -oE '/nix/store/[a-z0-9]+-vivarium-first-microvm-launch-arguments\.json' "$runner_out/bin/vivarium-first-microvm" 2>/dev/null | head -n1)
fi
size_mib=$(jq -r '.volumeLaunch[] | select(.argName == "store-volume") | .sizeMiB' "$launcher_json" 2>/dev/null)
inode_ratio=$(jq -r '.volumeLaunch[] | select(.argName == "store-volume") | .inodeRatio' "$launcher_json" 2>/dev/null)
label=$(jq -r '.volumeLaunch[] | select(.argName == "store-volume") | .label' "$launcher_json" 2>/dev/null)

if [[ -z $size_mib || -z $inode_ratio || $inode_ratio == null ]]; then
  skip_remaining "the store volume's mkfs arguments could not be read from the launcher JSON" store-density-mkfs-argv-matches-runner store-density-probe-image-removed
else
  record "store-density-mkfs-argv-matches-runner: sizeMiB=$size_mib inodeRatio=$inode_ratio label=$label (read from $launcher_json, not reconstructed)"
  pass "store-density-mkfs-argv-matches-runner: the probe uses the launcher's own numbers"

  # e2fsprogs splits its binaries into a `bin` output and installs them under
  # sbin, so neither a bare store path nor a guessed subdirectory finds them.
  # Ask Nix for the output and then look, rather than constructing a path.
  mkfs_bin=$(command -v mkfs.ext4)
  dumpe2fs_bin=$(command -v dumpe2fs)
  if [[ ! -x ${mkfs_bin:-} || ! -x ${dumpe2fs_bin:-} ]]; then
    e2fs_out=$(nix build --no-link --print-out-paths 'nixpkgs#e2fsprogs.bin' 2>/dev/null | tail -n1)
    [[ -n $e2fs_out ]] || e2fs_out=$(nix build --no-link --print-out-paths 'nixpkgs#e2fsprogs' 2>/dev/null | tail -n1)
    # No `-type f`: mkfs.ext4 is a symlink to mke2fs in every packaging of
    # e2fsprogs, so filtering to regular files finds neither of them.
    [[ -x ${mkfs_bin:-} ]] || mkfs_bin=$(find "$e2fs_out" -name 'mkfs.ext4' 2>/dev/null | head -n1)
    [[ -x ${dumpe2fs_bin:-} ]] || dumpe2fs_bin=$(find "$e2fs_out" -name 'dumpe2fs' 2>/dev/null | head -n1)
  fi

  if [[ ! -x ${mkfs_bin:-} || ! -x ${dumpe2fs_bin:-} ]]; then
    skip_remaining "e2fsprogs (mkfs.ext4 and dumpe2fs) is not available" store-density-inode-table-lazy store-density-inode-table-lazy
  else
    record "store-density-inode-table-lazy: mkfs=$mkfs_bin dumpe2fs=$dumpe2fs_bin"
    truncate -s "${size_mib}M" "$PROBE_IMAGE" 2>"$TEMP_ROOT/mkfs.err"
    alloc_after_truncate=$(($(stat -c %b "$PROBE_IMAGE") * $(stat -c %B "$PROBE_IMAGE")))
    # Identical to nix/runner.nix's construction: -q, -L <label>, -i <ratio>.
    "$mkfs_bin" -q -L "$label" -i "$inode_ratio" "$PROBE_IMAGE" 2>>"$TEMP_ROOT/mkfs.err"
    mkfs_status=$?
    alloc_after_mkfs=$(($(stat -c %b "$PROBE_IMAGE") * $(stat -c %B "$PROBE_IMAGE")))

    if ((mkfs_status != 0)); then
      fail "store-density-inode-table-lazy: mkfs.ext4 failed" "$(tail -n 10 "$TEMP_ROOT/mkfs.err")"
    else
      "$dumpe2fs_bin" -h "$PROBE_IMAGE" >"$TEMP_ROOT/dumpe2fs.txt" 2>/dev/null
      features=$(sed -n 's/^Filesystem features: *//p' "$TEMP_ROOT/dumpe2fs.txt")
      inode_count=$(sed -n 's/^Inode count: *//p' "$TEMP_ROOT/dumpe2fs.txt")
      inode_size=$(sed -n 's/^Inode size: *//p' "$TEMP_ROOT/dumpe2fs.txt")
      block_count=$(sed -n 's/^Block count: *//p' "$TEMP_ROOT/dumpe2fs.txt")
      block_size=$(sed -n 's/^Block size: *//p' "$TEMP_ROOT/dumpe2fs.txt")
      group_count=$("$dumpe2fs_bin" "$PROBE_IMAGE" 2>/dev/null | grep -c '^Group ')
      table_bytes=$((inode_count * inode_size))

      # `uninit_bg` (or metadata_csum's equivalent) is what allows the kernel to
      # leave groups uninitialised and zero them in the background after mount.
      # Its presence is the hazard; its absence retires it.
      lazy=no
      grep -qE 'uninit_bg|metadata_csum' <<<"$features" && lazy=yes

      record "store-density-inode-table-lazy: inodes=$inode_count inode_size=$inode_size table_bytes=$table_bytes groups=$group_count blocks=$block_count block_size=$block_size"
      record "store-density-inode-table-lazy: features=$features"
      record "store-density-inode-table-lazy: background-zeroing possible=$lazy; image allocated after truncate=$alloc_after_truncate after mkfs=$alloc_after_mkfs bytes"
      record "store-density-inode-table-lazy: sysfs lazy_itable_init present=$([[ -e /sys/fs/ext4/features/lazy_itable_init ]] && echo yes || echo no) (mke2fs enables lazy init when it is)"

      if ((alloc_after_mkfs < table_bytes)); then
        pass "store-density-inode-table-lazy: mkfs left the table unwritten ($alloc_after_mkfs bytes allocated against a $table_bytes byte table), so the hazard is real and deferred to first mount"
      else
        pass "store-density-inode-table-lazy: mkfs wrote the table eagerly ($alloc_after_mkfs bytes allocated against a $table_bytes byte table), so there is nothing left to zero after mount"
      fi
    fi
  fi

  rm -f -- "$PROBE_IMAGE"
  if [[ -e $PROBE_IMAGE ]]; then
    fail "store-density-probe-image-removed: the ${size_mib}MiB probe image survived"
  else
    pass "store-density-probe-image-removed: the probe image is gone"
  fi
fi

leftovers=$(find "$VOLUME_DIR" -maxdepth 1 -name 'inode-table-probe*' 2>/dev/null | head -n 5)
if [[ -z $leftovers ]]; then
  pass "store-density-cleanup: no probe artefacts outside the scratch directory"
else
  fail "store-density-cleanup: probe artefacts escaped the scratch directory" "$leftovers"
fi

printf '\nSummary\n'
printf 'PASS=%d FAIL=%d SKIP=%d RECORD=%d\n' "$PASS_COUNT" "$FAIL_COUNT" "$SKIP_COUNT" "$RECORD_COUNT"
if ((FAIL_COUNT == 0)); then
  printf 'VERDICT: PASS (RECORD findings are the measurement; SKIPs require a capable host)\n'
  exit 0
else
  printf 'VERDICT: FAIL (%d hard check(s) failed — the measurement could not be taken)\n' "$FAIL_COUNT"
  exit 1
fi
